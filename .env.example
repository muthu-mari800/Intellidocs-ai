# Copy this file to .env and fill in your own values. NEVER commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
# Model id is configurable; check Google AI Studio for currently available models.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=120
MAX_FILE_MB=5
MAX_DOCUMENT_CHARS=30000
MAX_PDF_PAGES=30
CHUNK_OVERLAP_CHARS=1000
MAX_CHUNKS=8
# Optional: used automatically if the main model is overloaded (503) or not found (404)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
